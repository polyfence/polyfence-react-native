<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar notification icon — Polyfence mark "THE VOID".
  Android requires notification small-icons to be pure white with
  transparent background (Android tints and silhouettes them).

  To use it, set the drawable's NAME on the tracking notification:

    Polyfence.instance.updateConfiguration({
      notificationText: { trackingIconName: 'ic_notification' },
    })

  A name rather than a resource id, because ids move when the host app's
  resources change. Unset, polyfence-core falls back to the platform
  location glyph. Needs polyfence-core 3.1.0 or later.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="64"
    android:viewportHeight="64">
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M6,6 H58 V58 H6 Z M6,16 L30,16 L48,42 L48,58 L40,58 L40,46 L24,24 L6,24 Z"/>
</vector>
